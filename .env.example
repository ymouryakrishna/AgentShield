# ==============================================================================
# AgentShield — Environment Configuration Template
# ==============================================================================
# Quickstart:
# Zero-config mock payment mode is enabled by default.
# For individual services, copy the respective template:
#   Backend:  cp backend/.env.example backend/.env
#   Frontend: cp frontend/.env.example frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Persistence: 'memory' (default, in-memory store) | 'mongodb' (MongoDB URI)
PERSISTENCE_MODE=memory
MONGODB_URI=mongodb://localhost:27017/agentshield

# Razorpay Payment Gateway: 'mock' (zero-config demo) | 'live'
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=rzp_test_AgentShield2026
RAZORPAY_KEY_SECRET=mock_secret_key_agentshield_2026

# Cryptographic HMAC-SHA256 Token Secret for Policy Gated Authorizations
POLICY_TOKEN_SECRET=agentshield_policy_token_secret_key_2026

# Security & Rate Limiting Thresholds
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_AgentShield2026
